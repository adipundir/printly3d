# Printly configuration. Copy to .env and fill in. NEVER commit .env.

# HTTP port for local dev
PORT=3000

# --- AI model generation (OpenRouter) ---
# Get a key at https://openrouter.ai/keys . Without a key, the service falls back to the
# built-in parametric templates (keychain / nameplate / coin).
OPENROUTER_API_KEY=
# Any OpenRouter model that returns JSON. Free models are slower (~20-30s).
OPENROUTER_MODEL=poolside/laguna-xs-2.1:free

# --- Payment (x402 on X Layer) ---
# Your X Layer wallet address that receives the service fee. SET THIS BEFORE GOING LIVE.
PAY_TO=0x0000000000000000000000000000000000000000
# Service fee per model, in atomic USDT0 units (6 decimals). 50000 = 0.05 USDT0.
MODEL_PRICE_ATOMIC=50000

# --- Misc ---
# External print service the viewer page links to (payment/shipping happen there, not here).
PRINT_HANDOFF_URL=https://craftcloud3d.com/
# Override the base URL used in generated viewer/STL links (set to the public deploy URL).
PUBLIC_BASE_URL=
