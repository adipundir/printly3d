# Printly configuration. Copy to .env and fill in. NEVER commit .env.

# HTTP port for local dev
PORT=3000

# --- AI model generation (OpenRouter) ---
# Get a key at https://openrouter.ai/keys . Without a key, the service falls back to the
# built-in parametric templates (keychain / nameplate / coin).
OPENROUTER_API_KEY=
# Any OpenRouter model that returns JSON. Free models are slower (~20-30s).
OPENROUTER_MODEL=poolside/laguna-xs-2.1:free

# --- Payment: official OKX Payment SDK (x402 on X Layer) ---
# API key for the OKX facilitator, which verifies and settles every payment on our behalf.
# Create one at https://web3.okx.com/onchainos/dev-portal (Create API key -> name + passphrase;
# the secret is shown once). REQUIRED — without all three, /v1/model refuses every request.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Facilitator host. Leave as-is unless OKX says otherwise.
OKX_BASE_URL=https://web3.okx.com

# Your X Layer wallet address that receives the service fee. SET THIS BEFORE GOING LIVE.
PAY_TO=0x0000000000000000000000000000000000000000
# Service fee per model, in USD; the SDK converts it to atomic USD₮0. 0.05 = 0.05 USD₮0.
MODEL_PRICE_USD=0.05
# CAIP-2 network. eip155:196 = X Layer mainnet, eip155:1952 = X Layer testnet (free testing).
X402_NETWORK=eip155:196
# Optional, comma-separated: payer addresses served without being charged once the facilitator
# confirms their signature — for OKX's own review / sampling calls.
X402_EXEMPT_PAYERS=

# --- Misc ---
# External print service the viewer page links to (payment/shipping happen there, not here).
PRINT_HANDOFF_URL=https://craftcloud3d.com/
# Override the base URL used in generated viewer/STL links (set to the public deploy URL).
PUBLIC_BASE_URL=
