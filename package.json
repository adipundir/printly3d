{
  "name": "printly-asp",
  "version": "0.1.0",
  "description": "Printly — prompt-to-printable-STL ASP for OKX.AI (A2MCP, x402 on X Layer)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "serve": "tsx src/server/index.ts",
    "build:app": "tsc -p tsconfig.build.json",
    "bundle": "esbuild src/server/vercel-entry.ts --bundle --platform=node --format=esm --target=node20 --outfile=api/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@jscad/modeling": "^2.13.0",
    "@jscad/stl-serializer": "^2.1.23",
    "hono": "^4.6.14",
    "viem": "^2.21.54",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
